rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquier usuario autenticado puede leer/escribir procesos, correos, auditoría
    // Para MVP multi-correo: todos ven lo mismo (compartido). Luego podemos filtrar por owner.
    match /procesos/{docId} {
      allow read, write: if request.auth != null;
    }
    match /correos/{docId} {
      allow read, write: if request.auth != null;
    }
    match /auditoria/{docId} {
      allow read, write: if request.auth != null;
    }
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Permitir todo lo demás solo a autenticados por ahora
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
